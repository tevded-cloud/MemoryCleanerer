<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Cleanerer</AssemblyName>
    <Product>Cleanerer</Product>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!--
      WFAC010: WinForms' analyzer flags the manifest's PerMonitorV2 DPI settings as
      redundant with its own high-DPI API, but this is a WPF app (UseWindowsForms is
      only enabled for the future tray icon) — the manifest is the correct, WPF-standard
      way to declare DPI awareness, so this warning is a false positive here.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- app.ico doubles as the tray/window icon at runtime; app-logo.png is the in-app logo tile. -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-logo.png" />
  </ItemGroup>

  <!--
    Single-exe publish. This PropertyGroup only takes effect when explicitly requested via
    /p:PublishSingleExe=true, so normal Debug/Release builds are unaffected.

    Usage:
      dotnet publish -c Release -r win-x64 /p:PublishSingleExe=true /p:PublishSingleFile=true /p:SelfContained=true

    Or simply:
      dotnet publish -c Release -r win-x64 /p:PublishSingleFile=true /p:SelfContained=true
  -->
  <PropertyGroup Condition="'$(PublishSingleExe)'=='true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Compression is deliberately OFF: compressed assemblies must be inflated into private,
      unshareable memory at load, costing the running app 100+ MB of working set. Uncompressed
      assemblies are memory-mapped straight from the exe (evictable, demand-paged). The exe on
      disk is bigger, but the download zip barely changes since the zip does its own compression.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Trades a little GC eagerness for a flatter heap; sensible for a background utility. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- GPU utilization is read from the "GPU Engine" performance counters (same source Task
         Manager uses); PerformanceCounter is not part of the base net8.0-windows surface. -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>

</Project>
