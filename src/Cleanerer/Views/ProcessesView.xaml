<UserControl x:Class="Cleanerer.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cleanerer.ViewModels"
             xmlns:conv="clr-namespace:Cleanerer.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="840"
             d:DataContext="{d:DesignInstance Type=vm:ProcessesViewModel}"
             Background="{StaticResource Brush.Bg}">
    <UserControl.Resources>
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="PRO — FREE HERE" Style="{StaticResource Style.Text.Kicker}"/>
            <TextBlock Text="Processes" Style="{StaticResource Style.Text.PageTitle}" Margin="0,4,0,6"/>
            <TextBlock Text="Monitor what's running, trim memory hogs, and let Cleanerer auto-manage the noisy ones."
                       Style="{StaticResource Style.Text.Body}" Margin="0,0,0,14"/>
        </StackPanel>

        <!-- ===================== Toolbar: search + aggregate line ===================== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource Style.TextBox.Search}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Search processes…"
                           Style="{StaticResource Style.Text.Body}"
                           FontSize="13"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
            </Grid>

            <TextBlock Grid.Column="1"
                       Text="{Binding AggregateLine}"
                       Style="{StaticResource Style.Text.Body}"
                       FontSize="12"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ===================== Grid card + status line ===================== -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Style.Card}" Padding="0">
                <DataGrid Style="{StaticResource Style.DataGrid}"
                          ItemsSource="{Binding RowsView}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>

                        <DataGridTextColumn Header="CPU"
                                             Binding="{Binding CpuPercentFormatted}"
                                             SortMemberPath="CpuPercent"
                                             Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="WORKING SET"
                                             Binding="{Binding WorkingSetFormatted}"
                                             SortMemberPath="WorkingSetBytes"
                                             Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="PRIVATE"
                                             Binding="{Binding PrivateFormatted}"
                                             SortMemberPath="PrivateBytes"
                                             Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="ACTIONS" Width="140" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Trim"
                                                Style="{StaticResource Style.Button.GhostCompact}"
                                                Command="{Binding TrimCommand}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Kill"
                                                Style="{StaticResource Style.Button.DangerOutlineCompact}"
                                                Command="{Binding KillCommand}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ===================== Status line ===================== -->
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusMessage}"
                       Margin="4,10,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringEmptyToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- ===================== Automatic rules card ===================== -->
        <Border Grid.Row="3" Style="{StaticResource Style.Card}" Padding="20" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Automatic rules" Style="{StaticResource Style.Text.PageTitle}" FontSize="17"/>
                <TextBlock Text="Cleanerer trims or kills matching processes automatically. Core Windows processes are always protected — a Kill rule aimed at one is blocked."
                           Style="{StaticResource Style.Text.Body}" FontSize="12" Margin="0,4,0,14"/>

                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RuleRowViewModel}">
                                <StackPanel Margin="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource Style.Toggle}"
                                                  IsChecked="{Binding Enabled}"
                                                  Margin="0,0,14,0"/>

                                        <Grid Grid.Column="1" Margin="0,0,12,0">
                                            <TextBox x:Name="RuleName"
                                                     Style="{StaticResource Style.TextBox.Rule}"
                                                     Text="{Binding MatchName, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="any process"
                                                       Style="{StaticResource Style.Text.Body}"
                                                       FontSize="12"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       Visibility="{Binding MatchName, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                                        </Grid>

                                        <TextBlock Grid.Column="2" Text="working set >"
                                                   Style="{StaticResource Style.Text.Body}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <TextBox Grid.Column="3"
                                                 Style="{StaticResource Style.TextBox.Numeric}"
                                                 Text="{Binding ThresholdMb, UpdateSourceTrigger=LostFocus}"/>

                                        <TextBlock Grid.Column="4" Text="MB"
                                                   Style="{StaticResource Style.Text.Body}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="8,0,12,0"/>

                                        <ComboBox Grid.Column="5"
                                                  Style="{StaticResource Style.ComboBox}"
                                                  Width="86"
                                                  ItemsSource="{Binding ActionOptions}"
                                                  SelectedItem="{Binding Action}"/>

                                        <Button Grid.Column="7" Content="Delete"
                                                Style="{StaticResource Style.Button.DangerOutlineCompact}"
                                                Command="{Binding DeleteCommand}"/>
                                    </Grid>

                                    <TextBlock Text="⚠ protected — kill will be blocked"
                                               Foreground="{StaticResource Brush.Danger}"
                                               Opacity="0.85"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="54,4,0,0"
                                               Visibility="{Binding ShowProtectedWarning, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Add-a-rule dashed CTA -->
                <Button Style="{StaticResource Style.Card.DashedCta}"
                        Command="{Binding AddRuleCommand}"
                        Margin="0,10,0,0"
                        Content="＋  Add a rule — e.g. trim chrome when it passes 2,048 MB"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
