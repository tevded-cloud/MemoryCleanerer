<UserControl x:Class="Cleanerer.Views.RulesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cleanerer.ViewModels"
             xmlns:conv="clr-namespace:Cleanerer.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:RulesPanelViewModel}">
    <UserControl.Resources>
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Style.Card}" Padding="16">
            <StackPanel>
                <TextBlock Text="Automatic rules" FontFamily="{StaticResource Font.Default}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock Text="Memory Cleanerer trims or kills matching processes automatically. Core Windows processes are always protected. A Kill rule aimed at one is blocked."
                           Style="{StaticResource Style.Text.Body}" FontSize="12" Margin="0,4,0,12"/>

                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RuleRowViewModel}">
                                <StackPanel Margin="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource Style.Toggle}"
                                                  IsChecked="{Binding Enabled}"
                                                  Margin="0,0,14,0"/>

                                        <Grid Grid.Column="1" Margin="0,0,12,0">
                                            <TextBox x:Name="RuleName"
                                                     Style="{StaticResource Style.TextBox.Rule}"
                                                     Text="{Binding MatchName, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="any process"
                                                       Style="{StaticResource Style.Text.Body}"
                                                       FontSize="12"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       Visibility="{Binding MatchName, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                                        </Grid>

                                        <TextBlock Grid.Column="2" Text="working set >"
                                                   Style="{StaticResource Style.Text.Body}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <TextBox Grid.Column="3"
                                                 Style="{StaticResource Style.TextBox.Numeric}"
                                                 Text="{Binding ThresholdMb, UpdateSourceTrigger=LostFocus}"/>

                                        <TextBlock Grid.Column="4" Text="MB"
                                                   Style="{StaticResource Style.Text.Body}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="8,0,12,0"/>

                                        <ComboBox Grid.Column="5"
                                                  Style="{StaticResource Style.ComboBox}"
                                                  Width="86"
                                                  ItemsSource="{Binding ActionOptions}"
                                                  SelectedItem="{Binding Action}"/>

                                        <Button Grid.Column="7" Content="Delete"
                                                Style="{StaticResource Style.Button.DangerOutlineCompact}"
                                                Command="{Binding DeleteCommand}"/>
                                    </Grid>

                                    <TextBlock Text="⚠ protected, kill will be blocked"
                                               Foreground="{StaticResource Brush.Danger}"
                                               Opacity="0.85"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="54,4,0,0"
                                               Visibility="{Binding ShowProtectedWarning, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Add-a-rule dashed CTA -->
                <Button Style="{StaticResource Style.Card.DashedCta}"
                        Command="{Binding AddRuleCommand}"
                        Margin="0,10,0,0"
                        Content="＋  Add a rule (e.g. trim chrome when it passes 2,048 MB)"/>
            </StackPanel>
        </Border>

        <!-- Transient status line for scheduler rule reports -->
        <TextBlock Text="{Binding StatusMessage}"
                   Margin="4,8,0,0"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringEmptyToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
