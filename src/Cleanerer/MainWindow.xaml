<Window x:Class="Cleanerer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Cleanerer.ViewModels"
        xmlns:local="clr-namespace:Cleanerer"
        mc:Ignorable="d"
        Title="Cleanerer"
        Width="825" Height="540"
        MinWidth="780" MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Font.Default}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- WindowStyle=None + AllowsTransparency lets the root Border below draw real 14px rounded
         corners (matching Radius.Card) — DWM's built-in rounding maxes out around 8px. The
         trade-offs are handled in code-behind: WM_GETMINMAXINFO caps the maximized size to the
         work area (borderless windows otherwise cover the taskbar), and corners square off
         while maximized. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Compact nav item for the title-bar strip: small glyph + title only, no subtitle. -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="Style.NavListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- Items MUST stay focusable: ListBoxItem's mouse-down handler only selects an item
                 it can successfully focus, so Focusable=False makes nav clicks dead on arrival.
                 The focus rectangle is suppressed instead. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Card}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentDim}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.NavListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemTemplate" Value="{StaticResource NavItemTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Style.NavListBoxItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="WindowRoot" Background="{StaticResource Brush.Bg}" CornerRadius="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Title bar: branding + all navigation ===================== -->
        <Border x:Name="TitleBarRoot" Grid.Row="0" Background="{StaticResource Brush.Sidebar}" CornerRadius="13,13,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Brush.Accent}">
                    <TextBlock Text="C" FontWeight="Bold" FontSize="12" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Cleanerer" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Style.Badge.Success}" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Free forever" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Success}"/>
                </Border>

                <!-- CRITICAL: this ListBox sits in the WindowChrome caption (drag) area — without
                     IsHitTestVisibleInChrome, every nav click is eaten by the drag region instead
                     of reaching the ListBoxItem. See Style.NavListBoxItem above for the matching
                     Focusable requirement. -->
                <ListBox Style="{StaticResource Style.NavListBox}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Margin="20,0,0,0"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Content="&#xE921;"
                        Style="{StaticResource Style.Button.Caption}"
                        Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeRestoreButton" Content="&#xE922;"
                        Style="{StaticResource Style.Button.Caption}"
                        Click="MaximizeRestoreButton_Click"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;"
                        Style="{StaticResource Style.Button.CaptionClose}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
    </Grid>
    </Border>
</Window>
