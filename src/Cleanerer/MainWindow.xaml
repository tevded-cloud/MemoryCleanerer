<Window x:Class="Cleanerer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Cleanerer.ViewModels"
        xmlns:local="clr-namespace:Cleanerer"
        mc:Ignorable="d"
        Title="Cleanerer"
        Width="1100" Height="720"
        MinWidth="980" MinHeight="640"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Default}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2">
                <Border Style="{StaticResource Style.Nav.IconBadge}">
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="Style.NavListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                CornerRadius="{StaticResource Radius.Button}"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Card}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentDim}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.NavListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemTemplate" Value="{StaticResource NavItemTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Style.NavListBoxItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Title bar ===================== -->
        <Grid Grid.Row="0" Background="{StaticResource Brush.Sidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource Brush.Accent}">
                    <TextBlock Text="C" FontWeight="Bold" FontSize="13" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Cleanerer" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Style.Pill.Success}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Free forever" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Success}"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Content="&#xE921;"
                        Style="{StaticResource Style.Button.Caption}"
                        Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeRestoreButton" Content="&#xE922;"
                        Style="{StaticResource Style.Button.Caption}"
                        Click="MaximizeRestoreButton_Click"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;"
                        Style="{StaticResource Style.Button.CaptionClose}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===================== Body: sidebar + content ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.CardBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="20,24,20,24" LastChildFill="False">

                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Brush.Accent}">
                                <TextBlock Text="C" FontWeight="Bold" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Cleanerer" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource Brush.TextPrimary}"/>
                                <TextBlock Text="v0.1.0" FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="MONITOR" Style="{StaticResource Style.Text.SectionLabel}" Margin="4,28,0,8"/>
                        <ListBox Style="{StaticResource Style.NavListBox}"
                                 ItemsSource="{Binding MonitorItems}"
                                 SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"/>

                        <TextBlock Text="CONTROL" Style="{StaticResource Style.Text.SectionLabel}" Margin="4,20,0,8"/>
                        <ListBox Style="{StaticResource Style.NavListBox}"
                                 ItemsSource="{Binding ControlItems}"
                                 SelectedItem="{Binding SelectedControl, Mode=TwoWay}"/>
                    </StackPanel>

                    <ListBox DockPanel.Dock="Bottom"
                             Style="{StaticResource Style.NavListBox}"
                             ItemsSource="{Binding AboutItems}"
                             SelectedItem="{Binding SelectedAbout, Mode=TwoWay}"/>

                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</Window>
